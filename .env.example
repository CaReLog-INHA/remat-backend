IMAGE=ghcr.io/zeoueon/remat-backend:latest

# Database
DB_URL=jdbc:postgresql://<host>:5432/remat_server
DB_USER=
DB_PW=

# JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=86400000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
